;\r\nfunction Manupulat(props){\r\n    let [V,SetV]=useState([...props.T]);\r\n    let [X,SetX]=useState(\"\");\r\n    let [MssEr,SetMssEr]=useState(\"\")\r\n    let f1=(event)=>{SetX(event.target.value)}\r\n    return(\r\n        <>\r\n        <form>\r\n        <label>ville</label><br></br>\r\n        <input  type=\"text\" value={X} onChange={f1}/>\r\n        <button type=\"button\"onClick={()=>{\r\n            if (X==''){SetMssEr('insserer une ville svp')}\r\n            else{\r\n             SetV([...V,X])\r\n                SetX('')\r\n                SetMssEr('')}}}\r\n           >ajouter</button>\r\n        <ul>{V.map((k,i)=>(<li key={i}>{k} \r\n            <button \r\n             type=\"button\" onClick={()=>{\r\n              let E=V.filter((a,j)=>{return(k!=a)})\r\n             SetV(E)}}>la suppression</button>\r\n              </li>))}</ul>\r\n\r\n\r\n\r\n             <button type=\"button\" onClick={()=>{\r\n            let E=V.filter((a,j)=>(X!=a))\r\n            SetV(E)\r\n        }}>supprimer</button>\r\n            <span style={{color:\"red\"}}>{MssEr}</span>\r\n        </form>\r\n        </>\r\n    )\r\n}\r\nexport default Manupulat ","C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\tp12.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\weather.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\essaie.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\essa2.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\wethess.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\home.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\esshm.js",[],[],"C:\\Users\\ThinKpad\\Documents\\KHAL PJ\\src\\whtess.js",[],[],{"ruleId":"106","severity":1,"message":"107","line":3,"column":7,"nodeType":"108","messageId":"109","endLine":3,"endColumn":10},{"ruleId":"106","severity":1,"message":"110","line":4,"column":7,"nodeType":"108","messageId":"109","endLine":4,"endColumn":13},{"ruleId":"106","severity":1,"message":"111","line":3,"column":11,